rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      // Admin por email (cuenta existente) O por custom claim admin==true.
      return request.auth != null && (
        request.auth.token.email == 'admin@robosmdp.com.ar'
        || request.auth.token.admin == true
      );
    }

    // Autor del doc (si en el futuro los docs guardan el uid del creador).
    function isAuthor() {
      return request.auth != null
          && 'uid' in resource.data
          && resource.data.uid == request.auth.uid;
    }

    // Alta de reportes de mapa: descripción 1..500 + coordenadas numéricas.
    function validReportCreate() {
      let d = request.resource.data;
      return d.description is string && d.description.size() > 0 && d.description.size() <= 500
          && d.lat is number && d.lng is number;
    }

    // Updates permitidos en reportes: admin/autor, o cambios anónimos acotados
    // que la app ya hace: sumar "me preocupa" (+1). Resolver: solo admin.
    function reportUpdateOK() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return isAdmin() || isAuthor()
          || (changed.hasOnly(['concerns'])
              && request.resource.data.concerns == resource.data.get('concerns', 0) + 1);
    }

    function reservedName(a) {
      return a is string && (
        a.lower().matches('.*admin.*') ||
        a.lower().matches('.*robosmdp.*') ||
        a.lower().matches('.*oficial.*') ||
        a.lower().matches('.*verificad.*')
      );
    }

    function honestAuthor() {
      return (!('admin' in request.resource.data) || request.resource.data.admin == false || isAdmin())
          && (!('apodo' in request.resource.data) || !reservedName(request.resource.data.apodo) || isAdmin());
    }

    // ===== Helpers del Chat Vecinal v2 (identidad por UID) =====
    function isSignedIn() {
      return request.auth != null;
    }
    function banRef() {
      return /databases/$(database)/documents/chat_bans/$(request.auth.uid);
    }
    // Baneado = existe su doc de ban por UID y sigue vigente (permanente = sin ban_hasta).
    function isBanned() {
      return isSignedIn()
        && exists(banRef())
        && (get(banRef()).data.ban_hasta == null
            || get(banRef()).data.ban_hasta > request.time);
    }
    // Moderador = tiene doc en chat_moderadores indexado por su UID.
    function isMod() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/chat_moderadores/$(request.auth.uid));
    }

    // ===========================================================
    //  COLECCIONES PÚBLICAS ENDURECIDAS (antes: todo abierto)
    //  read: libre · create: validado (sin auth) · update: admin/autor
    //  + cambios anónimos acotados · delete: solo admin.
    // ===========================================================

    // --- Reportes de mapa (misma forma: description/lat/lng) ---
    match /artifacts/{appId}/public/data/reports/{rid} {
      allow read: if true;
      allow create: if validReportCreate();
      allow update: if reportUpdateOK();
      allow delete: if isAdmin();
    }
    match /reportes/{docId} {
      allow read: if true;
      allow create: if validReportCreate();
      allow update: if reportUpdateOK();
      allow delete: if isAdmin();
    }
    match /basura/{docId} {
      allow read: if true;
      allow create: if validReportCreate();
      allow update: if reportUpdateOK();
      allow delete: if isAdmin();
    }
    match /pozos/{docId} {
      allow read: if true;
      allow create: if validReportCreate();
      allow update: if reportUpdateOK();
      allow delete: if isAdmin();
    }
    match /abandonados/{docId} {
      allow read: if true;
      allow create: if validReportCreate();
      allow update: if reportUpdateOK();
      allow delete: if isAdmin();
    }
    match /luminarias/{docId} {
      allow read: if true;
      allow create: if validReportCreate();
      allow update: if reportUpdateOK();
      allow delete: if isAdmin();
    }

    // --- Patentes: alta validada; update público SOLO para marcar resuelto=true ---
    match /patentes/{docId} {
      allow read: if true;
      allow create: if request.resource.data.patente is string
                  && request.resource.data.patente.size() > 0
                  && request.resource.data.patente.size() <= 20
                  && (!('descripcion' in request.resource.data)
                      || (request.resource.data.descripcion is string
                          && request.resource.data.descripcion.size() <= 500));
      allow update: if isAdmin() || isAuthor()
                  || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resuelto'])
                      && request.resource.data.resuelto == true);
      allow delete: if isAdmin();
    }

    // --- Objetos perdidos: alta validada; update público SOLO para resuelto=true ---
    match /objetos_perdidos/{docId} {
      allow read: if true;
      allow create: if request.resource.data.descripcion is string
                  && request.resource.data.descripcion.size() > 0
                  && request.resource.data.descripcion.size() <= 500;
      allow update: if isAdmin() || isAuthor()
                  || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resuelto'])
                      && request.resource.data.resuelto == true);
      allow delete: if isAdmin();
    }

    // --- Avisos de resolución (foto que manda un vecino): alta validada; el
    //     admin los procesa (update) y los borra. ---
    match /notificaciones_resolucion/{docId} {
      allow read: if true;
      allow create: if request.resource.data.reportId is string
                  && request.resource.data.reportType is string
                  && (!('reportDescription' in request.resource.data)
                      || (request.resource.data.reportDescription is string
                          && request.resource.data.reportDescription.size() <= 500));
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // --- Suscripciones push: cada navegador crea/actualiza SU doc (por id de
    //     localStorage) solo con campos de zona. read = admin (contienen tokens,
    //     NO deben ser legibles por cualquiera; el server los lee con Admin SDK). ---
    match /subscripciones_push/{docId} {
      allow read: if isAdmin();
      allow create: if request.resource.data.token is string
                  && request.resource.data.lat is number
                  && request.resource.data.lng is number
                  && request.resource.data.radius is number;
      allow update: if isAdmin()
                  || request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['lat','lng','radius','updatedAt']);
      allow delete: if isAdmin();
    }

    // --- Contadores (incrementos públicos por diseño; hoy sin uso desde el
    //     cliente). Se dejan escribibles para no romper incrementos; borrado admin. ---
    match /pageCounters/{docId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }
    match /stats/visitas {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }
    match /artifacts/{aid}/public/data/reports/{rid}/comentarios/{cid} {
      allow read: if true;
      allow create: if request.resource.data.texto is string
                  && request.resource.data.texto.size() > 0
                  && request.resource.data.texto.size() <= 280
                  && honestAuthor();
      allow update: if false;
      allow delete: if isAdmin();
    }
    match /{col}/{rid}/comentarios/{cid} {
      allow read: if col in ['basura','pozos','abandonados','luminarias','reportes'];
      allow create: if col in ['basura','pozos','abandonados','luminarias','reportes']
                  && request.resource.data.texto is string
                  && request.resource.data.texto.size() > 0
                  && request.resource.data.texto.size() <= 280
                  && honestAuthor();
      allow update: if false;
      allow delete: if col in ['basura','pozos','abandonados','luminarias','reportes'] && isAdmin();
    }
    match /foro/{tid} {
      allow read: if true;
      allow create: if request.resource.data.titulo is string
                  && request.resource.data.titulo.size() > 0
                  && request.resource.data.titulo.size() <= 100
                  && request.resource.data.cuerpo is string
                  && request.resource.data.cuerpo.size() <= 1000
                  && request.resource.data.respuestas_count == 0
                  && honestAuthor();
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['respuestas_count']);
      allow delete: if isAdmin();
      match /respuestas/{rid} {
        allow read: if true;
        allow create: if request.resource.data.texto is string
                    && request.resource.data.texto.size() > 0
                    && request.resource.data.texto.size() <= 1000
                    && honestAuthor();
        allow update: if false;
        allow delete: if isAdmin();
      }
    }
    match /rastreo_registros/{docId} {
      allow create: if true;
      allow read, delete: if isAdmin();
      allow update: if false;
    }
    match /mascotas/{id} {
      allow read: if true;
      allow create: if true;
      allow update: if isAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resuelto'])
        && request.resource.data.resuelto == true
      );
      allow delete: if isAdmin();
    }

    // ===========================================================
    //  CHAT VECINAL v2 — identidad y moderación por UID de Auth
    // ===========================================================

    // Mensajes: solo autenticados y NO baneados leen/escriben. El uid del
    // mensaje debe ser el del autor y no se puede auto-atribuir admin/moderador.
    match /chat_publico/{msgId} {
      allow read: if isAdmin() || (isSignedIn() && !isBanned());
      allow create: if isSignedIn() && !isBanned()
                  && request.resource.data.uid == request.auth.uid
                  && request.resource.data.keys().hasOnly(['uid','apodo','texto','admin','moderador','timestamp','replyTo','media'])
                  && request.resource.data.texto is string
                  && request.resource.data.texto.size() <= 280
                  && (request.resource.data.texto.size() > 0 || 'media' in request.resource.data)
                  && request.resource.data.apodo is string
                  && request.resource.data.apodo.size() <= 40
                  && request.resource.data.timestamp == request.time
                  && honestAuthor()
                  && (!('moderador' in request.resource.data)
                      || request.resource.data.moderador == false
                      || isMod() || isAdmin())
                  // Imágenes/videos: SOLO el admin puede adjuntar media.
                  && (!('media' in request.resource.data)
                      || (isAdmin()
                          && request.resource.data.media.url is string
                          && request.resource.data.media.type is string));
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Presencia atada al UID autenticado. El admin puede escribir la de otros
    // para marcarla inactiva al banear. La limpieza programada usa Service
    // Account vía REST y no pasa por estas reglas.
    match /chat_presencia/{sessionId} {
      // Presencia pública sin IP: migrar primero todos los campos heredados.
      allow read: if isAdmin() || (isSignedIn() && !isBanned());
      allow create: if isAdmin()
          || (isSignedIn() && !isBanned()
              && request.resource.data.uid == request.auth.uid
              && request.resource.data.keys().hasOnly(
                  ['uid','apodo','ultimo_ping','activo','fingerprint']));
      allow update: if isAdmin()
          || (isSignedIn() && !isBanned()
              && resource.data.uid == request.auth.uid
              && request.resource.data.uid == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['apodo','ultimo_ping','activo','fingerprint']));
      allow delete: if isAdmin()
          || (isSignedIn() && resource.data.uid == request.auth.uid);
    }

    // IP y ubicación aproximada para moderación: lectura exclusiva admin.
    // Solo la función autenticada del servidor escribe con Service Account.
    match /chat_ip_private/{sessionId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Moderadores indexados por UID. La lista no es sensible (solo da el badge 🛡️);
    // asignarlos/quitarlos es exclusivo del administrador.
    match /chat_moderadores/{uid} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Baneos indexados por UID. Un vecino solo puede leer SU propio ban (para
    // auto-bloquearse en vivo); el admin lista todos y es el único que crea,
    // modifica o levanta sanciones.
    match /chat_bans/{uid} {
      allow get:  if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // Espejo de baneo por huella de dispositivo (FingerprintJS).
    // ID del doc = visitorId. Lectura por get() para firmados — no hay datos
    // sensibles, solo uid + ban_hasta. Lista solo admin; escritura solo admin.
    match /chat_bans_fp/{fingerprint} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // Espejo de baneo por apodo (nick en minúsculas).
    // ID del doc = apodo.toLowerCase(). Lectura por get() para firmados.
    match /chat_bans_nick/{nick} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
